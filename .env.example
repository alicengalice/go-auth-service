# JWT Configuration
# Required. Generate a random value (e.g. `openssl rand -base64 48`); at least 32 bytes.
# Must be identical to the backend's AUTH_JWT_SECRET. Never reuse a value from documentation.
JWT_SECRET=
# Optional; must match the backend's auth.jwt.issuer / auth.jwt.audience
JWT_ISSUER=expense-wise-auth
JWT_AUDIENCE=expense-wise-api

# Admin Credentials (required; the service won't start if either is empty)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Server Configuration
PORT=8081
