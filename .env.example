# JWT Configuration
# Must be at least 32 bytes and identical to the backend's AUTH_JWT_SECRET
JWT_SECRET=change-me-to-a-random-32-plus-byte-secret
# Optional; must match the backend's auth.jwt.issuer / auth.jwt.audience
JWT_ISSUER=expense-wise-auth
JWT_AUDIENCE=expense-wise-api

# Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Server Configuration
PORT=8081